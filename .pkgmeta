# BigWigs packager: the zip is the addon folder "WandererTraining", the changelog of the version is CHANGELOG.md
# (written at each release from the full changelog).
package-as: WandererTraining

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - README.md

# Shown on CurseForge: Wanderer Training needs Wanderer.
required-dependencies:
  - wanderer
